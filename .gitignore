# ============================================================
# 1. RAW PARTICIPANT-LEVEL DATA - NEVER COMMIT
# ============================================================
# Row-level records of individual participants. They combine
# directly identifying attributes (centre, class, age, sex) and
# must remain on local storage only.
Datos totales 20 sept 2026.csv
Cuestionario Brais pre-post.csv
totalesBrais.csv
descriptivosBrais.csv

# Belt-and-braces guards for any future raw-data location.
data/raw/
data/private/
*raw*.csv
*.pbix

# ============================================================
# 2. POWER BI MATERIAL - NEVER COMMIT
# ============================================================
# A .pbix file embeds its full data model, so publishing one
# would also publish the underlying participant records.
Brais TFM.pbix

